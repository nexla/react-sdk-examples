# Optional: pre-fill the connect form. You can also paste these in the UI.
VITE_NEXLA_API_BASE_URL=https://dataops.nexla.io/nexla-api
VITE_NEXLA_SERVICE_KEY=
VITE_NEXLA_SESSION_TOKEN=
VITE_NEXLA_END_USER_ID=demo-user
# Leave blank for a plain create form. With a service key and end-user ID, set it
# to enable "find-or-create the end user's credential" (app-scoped) mode.
VITE_NEXLA_APPLICATION_ID=
