# Copy to .env.local and fill in. Never commit real keys.

# Your Nexla API base URL — the SDK calls it directly (passed to NexlaConnectProvider's apiBaseUrl).
VITE_NEXLA_API_BASE_URL=https://dataops.nexla.io/nexla-api

# From your Nexla account / registered SDK application:
VITE_NEXLA_SERVICE_KEY=
VITE_NEXLA_APPLICATION_ID=
VITE_NEXLA_END_USER_ID=demo-user
